# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=child/nutrition

# MariaDB
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=nutrition_db
MARIADB_USER=nutrition_user
MARIADB_PASSWORD=nutrition_pass
MARIADB_ROOT_PASSWORD=root_pass

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nutrition_raw_db
MONGODB_COLLECTION=raw_messages

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

